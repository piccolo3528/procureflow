<mvc:View controllerName="procureflow.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core">
    <Page title="Dashboard">
        <content>
            <VBox class="sapUiSmallMargin">
                <MessageStrip
                    text="{= 'Welcome back, ' + ${ui>/currentUser/name} + '! Here is what is happening today.' }"
                    type="Information"
                    showIcon="true"
                    showCloseButton="true"
                    class="sapUiBottomMargin">
                </MessageStrip>

                <HBox class="sapUiBottomMargin">
                    <Button text="New Request" type="Emphasized" icon="sap-icon://add" press=".onCreatePress" />
                </HBox>

                <!-- KPIs -->
                <layout:Grid defaultSpan="XL3 L4 M6 S12" class="sapUiBottomMargin">
                    <GenericTile id="myRequestsTile" header="My Open Requests" subheader="Active" press=".onNavToPR" class="sapUiTinyMargin">
                        <TileContent>
                            <NumericContent value="{kpi>/myOpenRequests}" icon="sap-icon://document-text" valueColor="Good"/>
                        </TileContent>
                    </GenericTile>

                    <GenericTile id="draftsTile" header="My Drafts" subheader="Saved" press=".onNavToPR" class="sapUiTinyMargin">
                        <TileContent>
                            <NumericContent value="{kpi>/myDrafts}" icon="sap-icon://edit" valueColor="Neutral"/>
                        </TileContent>
                    </GenericTile>

                    <GenericTile id="pendingApprovalTile" header="Pending My Action" subheader="{ui>/currentUser/role}" press=".onNavToApprovals" class="sapUiTinyMargin"
                        visible="{= ${kpi>/pendingMyAction} !== undefined &amp;&amp; ${ui>/currentUser/role} !== 'Employee' }">
                        <TileContent>
                            <NumericContent value="{kpi>/pendingMyAction}" icon="sap-icon://accept" valueColor="Critical"/>
                        </TileContent>
                    </GenericTile>

                    <GenericTile id="vendorsTile" header="Active Vendors" subheader="Approved suppliers" class="sapUiTinyMargin">
                        <TileContent>
                            <NumericContent value="{kpi>/activeVendors}" icon="sap-icon://supplier" valueColor="Good"/>
                        </TileContent>
                    </GenericTile>
                </layout:Grid>

                <Title text="My Recent Purchase Requests" level="H2" class="sapUiTinyMarginBottom" />
                <Table id="recentTable" items="{path: '/PurchaseRequests', parameters: {$orderby: 'date desc'}, length: 5}" mode="SingleSelectMaster" selectionChange=".onPRSelect">
                    <columns>
                        <Column><Text text="Request ID" /></Column>
                        <Column><Text text="Title" /></Column>
                        <Column><Text text="Amount" /></Column>
                        <Column><Text text="Status" /></Column>
                        <Column><Text text="Date" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Navigation">
                            <cells>
                                <ObjectIdentifier title="{ID}" />
                                <Text text="{title}" />
                                <ObjectNumber number="{amount}" unit="{currency}" />
                                <ObjectStatus text="{status}"
                                    state="{= ${status} === 'Goods Received' || ${status} === 'PO Created' ? 'Success' : (${status} === 'Rejected' || ${status} === 'Cancelled' ? 'Error' : (${status} === 'Draft' ? 'None' : 'Warning')) }" />
                                <Text text="{date}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <Title text="Recent Activity" level="H2" class="sapUiTinyMarginBottom sapUiMediumMarginTop" />
                <Table id="activityTable" items="{path: '/AuditLogs', parameters: {$orderby: 'createdAt desc'}, length: 6}">
                    <columns>
                        <Column><Text text="When" /></Column>
                        <Column><Text text="Who" /></Column>
                        <Column><Text text="Action" /></Column>
                        <Column><Text text="Document" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{path: 'createdAt', formatter: '.formatter.relativeDateTime'}" />
                                <Text text="{user/name}" />
                                <Text text="{action}" />
                                <Text text="{businessObject}: {documentID}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
