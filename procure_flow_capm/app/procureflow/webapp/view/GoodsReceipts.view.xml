<mvc:View controllerName="procureflow.controller.GoodsReceipts"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <Page title="Goods Receipt" showNavButton="true" navButtonPress=".onNavBack">
        <headerContent>
            <Button text="Post Goods Receipt" type="Emphasized" press=".onPostGR" />
        </headerContent>
        <content>
            <layout:Splitter height="100%">
                <layout:contentAreas>
                    <VBox width="auto">
                        <layoutData><layout:SplitterLayoutData size="30%" resizable="true"/></layoutData>
                        <Title text="Open Purchase Orders" class="sapUiSmallMargin" level="H3"/>
                        <List id="poList" items="{path: '/PurchaseOrders', parameters: {$orderby: 'date asc'}}" mode="SingleSelectMaster" selectionChange=".onPOSelect" noDataText="No open Purchase Orders.">
                            <StandardListItem
                                title="{ID}"
                                description="{vendor/name}"
                                info="{status}"
                                type="Active" />
                        </List>
                    </VBox>
                    <VBox id="detailBox" visible="false" class="sapUiSmallMargin">
                        <layoutData><layout:SplitterLayoutData size="auto"/></layoutData>
                        <ObjectHeader title="{recv>/poId}" number="{recv>/amount}" numberUnit="{recv>/currency}" intro="Receive against Purchase Order">
                            <attributes>
                                <ObjectAttribute title="PO Number" text="{recv>/poId}"/>
                                <ObjectAttribute title="Vendor" text="{recv>/vendorName}"/>
                            </attributes>
                        </ObjectHeader>

                        <f:SimpleForm id="grHeaderForm" editable="true" layout="ColumnLayout" class="sapUiSmallMarginBottom">
                            <f:content>
                                <Label text="Location" />
                                <Input id="grLocation" value="{recv>/location}" placeholder="e.g. Main Warehouse"/>

                                <Label text="Notes" />
                                <TextArea id="grNotes" value="{recv>/notes}" rows="2" />
                            </f:content>
                        </f:SimpleForm>

                        <Table id="poItemsTable" items="{recv>/items}">
                            <headerToolbar>
                                <Toolbar>
                                    <Title text="Line Items to Receive" />
                                </Toolbar>
                            </headerToolbar>
                            <columns>
                                <Column><Text text="Item" /></Column>
                                <Column><Text text="Ordered" /></Column>
                                <Column><Text text="Received So Far" /></Column>
                                <Column><Text text="Receiving Now" /></Column>
                                <Column><Text text="Rejecting Now" /></Column>
                                <Column><Text text="Inspection" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{recv>description}" />
                                        <Text text="{recv>qtyOrdered}" />
                                        <Text text="{recv>alreadyReceived}" />
                                        <StepInput value="{recv>qtyReceivedNow}" min="0" max="{recv>remaining}" />
                                        <StepInput value="{recv>qtyRejectedNow}" min="0" max="{recv>remaining}" />
                                        <ComboBox selectedKey="{recv>inspectionResult}">
                                            <core:Item key="Good" text="Good" />
                                            <core:Item key="Damaged" text="Damaged" />
                                            <core:Item key="Incomplete" text="Incomplete" />
                                        </ComboBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </layout:contentAreas>
            </layout:Splitter>
        </content>
    </Page>
</mvc:View>
