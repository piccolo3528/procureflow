<mvc:View controllerName="procureflow.controller.GoodsReceipt"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <Page title="Goods Receipt" showNavButton="true" navButtonPress=".onNavBack">
        <headerContent>
            <Button text="Post Goods Receipt" type="Emphasized" press=".onPostGR" />
        </headerContent>
        <content>
            <layout:Splitter height="100%">
                <layout:contentAreas>
                    <VBox width="auto">
                        <layoutData><layout:SplitterLayoutData size="30%" resizable="true"/></layoutData>
                        <Title text="Open Purchase Orders" class="sapUiSmallMargin" level="H3"/>
                        <List id="poList" items="{mock>/PurchaseOrders}" mode="SingleSelectMaster" selectionChange=".onPOSelect">
                            <StandardListItem 
                                title="{mock>ID}"
                                description="{mock>vendor} - {mock>title}"
                                info="{mock>status}"
                                type="Active" />
                        </List>
                    </VBox>
                    <VBox id="detailBox" visible="false" class="sapUiSmallMargin">
                        <layoutData><layout:SplitterLayoutData size="auto"/></layoutData>
                        <ObjectHeader title="Receive against: {mock>ID}" 
                            number="{mock>amount}" 
                            numberUnit="{mock>currency}"
                            intro="{mock>title}">
                            <attributes>
                                <ObjectAttribute title="Vendor" text="{mock>vendor}"/>
                                <ObjectAttribute title="Buyer" text="{mock>buyer}"/>
                            </attributes>
                        </ObjectHeader>
                        
                        <f:SimpleForm editable="true" layout="ColumnLayout" class="sapUiSmallMarginBottom">
                            <f:content>
                                <Label text="Receiver Name" required="true" />
                                <Input id="receiverName" value="{ui>/users/0/name}" />
                                
                                <Label text="Delivery Note / Receipt" />
                                <Input id="deliveryNote" placeholder="Enter delivery note number..." />

                                <Label text="Notes" />
                                <TextArea id="grNotes" rows="2" />
                            </f:content>
                        </f:SimpleForm>

                        <Table id="poItemsTable" items="{mock>items}">
                            <headerToolbar>
                                <Toolbar>
                                    <Title text="Line Items to Receive" />
                                </Toolbar>
                            </headerToolbar>
                            <columns>
                                <Column><Text text="Item" /></Column>
                                <Column><Text text="Qty Ordered" /></Column>
                                <Column><Text text="Qty Received" /></Column>
                                <Column><Text text="Condition" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{mock>description}" />
                                        <Text text="{mock>qty}" />
                                        <StepInput value="{mock>qty}" min="0" max="{mock>qty}" />
                                        <ComboBox selectedKey="Good">
                                            <core:Item key="Good" text="Good" />
                                            <core:Item key="Damaged" text="Damaged" />
                                            <core:Item key="Incomplete" text="Incomplete" />
                                        </ComboBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </layout:contentAreas>
            </layout:Splitter>
        </content>
    </Page>
</mvc:View>
