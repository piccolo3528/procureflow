<mvc:View controllerName="procureflow.controller.Reports"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:mc="sap.suite.ui.microchart"
    xmlns:layout="sap.ui.layout">
    <Page title="Reports &amp; Analytics" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <MessageStrip text="Full analytical reporting (charts, filters, export) is planned for a later phase. These figures are live counts from the backend." type="Information" showIcon="true" class="sapUiSmallMargin"/>
            <layout:Grid defaultSpan="XL4 L4 M6 S12" class="sapUiSmallMargin">
                <GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop" header="Total Requests" subheader="All time">
                    <tileContent>
                        <TileContent footer="Purchase Requests">
                            <NumericContent value="{kpi>/totalRequests}" valueColor="Good" />
                        </TileContent>
                    </tileContent>
                </GenericTile>

                <GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop" header="Pending Approvals" subheader="Across all stages">
                    <tileContent>
                        <TileContent>
                            <NumericContent value="{kpi>/pendingApprovals}" valueColor="Critical" />
                        </TileContent>
                    </tileContent>
                </GenericTile>

                <GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop" header="Active Purchase Orders" subheader="Issued or partially received">
                    <tileContent>
                        <TileContent footer="Not yet closed">
                            <NumericContent value="{kpi>/activePOs}" valueColor="Neutral"/>
                        </TileContent>
                    </tileContent>
                </GenericTile>
            </layout:Grid>
            <Panel headerText="Spend by Vendor" class="sapUiSmallMargin">
                <Table items="{path: '/Vendors', parameters: {$orderby: 'spend desc'}}">
                    <columns>
                        <Column><Text text="Vendor" /></Column>
                        <Column><Text text="Category" /></Column>
                        <Column><Text text="Spend" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{name}" />
                                <Text text="{category}" />
                                <ObjectNumber number="{spend}" unit="USD" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>
        </content>
    </Page>
</mvc:View>
