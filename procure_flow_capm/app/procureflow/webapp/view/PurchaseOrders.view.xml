<mvc:View controllerName="procureflow.controller.PurchaseOrders"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core">
    <Page title="Purchase Orders" showNavButton="true" navButtonPress=".onNavBack">
        <headerContent>
            <Button icon="sap-icon://excel-attachment" text="Export" press=".onExport" />
        </headerContent>
        <content>
            <fb:FilterBar id="filterBar" search=".onSearch" showClearOnFB="true" clear=".onClear">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem groupName="G1" name="search" label="Search" visibleInFilterBar="true">
                        <fb:control>
                            <SearchField id="searchField" placeholder="Search by ID or Vendor..." />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem groupName="G1" name="status" label="Status" visibleInFilterBar="true">
                        <fb:control>
                            <ComboBox id="statusFilter">
                                <core:Item key="All" text="All Statuses" />
                                <core:Item key="Issued" text="Issued" />
                                <core:Item key="Partially Received" text="Partially Received" />
                                <core:Item key="Closed" text="Closed" />
                                <core:Item key="Cancelled" text="Cancelled" />
                            </ComboBox>
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>

            <Table id="poTable" items="{path: '/PurchaseOrders', parameters: {$orderby: 'date desc'}}" mode="None">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Purchase Orders" />
                        <ToolbarSpacer />
                        <Button icon="sap-icon://shipping-status" text="Goods Receipt" press=".onNavToGoodsReceipts" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><Text text="PO Number" /></Column>
                    <Column><Text text="Purchase Request" /></Column>
                    <Column><Text text="Vendor" /></Column>
                    <Column><Text text="Amount" /></Column>
                    <Column><Text text="Status" /></Column>
                    <Column><Text text="Buyer" /></Column>
                    <Column><Text text="Date" /></Column>
                    <Column><Text text="" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <ObjectIdentifier title="{ID}" />
                            <Text text="{request_ID}" />
                            <Text text="{vendor/name}"/>
                            <ObjectNumber number="{amount}" unit="{currency}" />
                            <ObjectStatus text="{status}"
                                state="{path: 'status', formatter: '.formatter.poStatusState'}" />
                            <Text text="{buyer/name}" />
                            <Text text="{date}" />
                            <Button text="Cancel" type="Transparent" press=".onCancelPOPress"
                                visible="{= (${status} === 'Issued' || ${status} === 'Partially Received') &amp;&amp; (${ui>/currentUser/role} === 'Procurement' || ${ui>/currentUser/role} === 'Admin') }"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
