<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <Dialog id="payInvoiceDialog" title="Execute Payment" contentWidth="26rem">
        <content>
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
                <f:content>
                    <Label text="Amount"/>
                    <ObjectNumber number="{pay>/amount}" unit="{pay>/currency}"/>
                    <Label text="Payment Method" required="true"/>
                    <Select selectedKey="{pay>/method}">
                        <core:Item key="Wire" text="Wire Transfer"/>
                        <core:Item key="ACH" text="ACH"/>
                        <core:Item key="Check" text="Check"/>
                    </Select>
                    <Label text="Bank Reference"/>
                    <Input value="{pay>/reference}" placeholder="Optional - generated if empty"/>
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button text="Pay" type="Accept" press=".onPayConfirm"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onPayCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
