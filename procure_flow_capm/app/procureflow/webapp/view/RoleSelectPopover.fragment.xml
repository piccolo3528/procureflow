<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Popover id="rolePopover" title="Switch Demo User" placement="Bottom">
        <List id="roleList" mode="SingleSelectMaster" selectionChange=".onRoleSelect" items="{ui>/demoUsers}">
            <StandardListItem id="roleListItem" title="{ui>name}" description="{ui>role}" icon="sap-icon://person-placeholder" iconInset="false" />
        </List>
    </Popover>
</core:FragmentDefinition>
