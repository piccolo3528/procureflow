<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <ResponsivePopover id="notificationsPopover" title="Notifications" placement="Bottom" contentWidth="26rem" contentHeight="28rem">
        <beginButton>
            <Button text="Mark all as read" press=".onMarkAllRead"/>
        </beginButton>
        <endButton>
            <Button text="Close" press=".onCloseNotifications"/>
        </endButton>
        <content>
            <List id="notificationsList" noDataText="You're all caught up."
                items="{path: '/Notifications', parameters: {$orderby: 'createdAt desc'}, length: 30}">
                <NotificationListItem
                    title="{title}"
                    description="{message}"
                    datetime="{path: 'createdAt', formatter: '.formatter.relativeDateTime'}"
                    unread="{= !${isRead} }"
                    priority="{= ${priority} === 'High' ? 'High' : (${priority} === 'Low' ? 'Low' : 'Medium') }"
                    showCloseButton="false"
                    press=".onNotificationPress"/>
            </List>
        </content>
    </ResponsivePopover>
</core:FragmentDefinition>
