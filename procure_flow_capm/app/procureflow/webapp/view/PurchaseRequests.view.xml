<mvc:View controllerName="procureflow.controller.PurchaseRequests"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core">
    <Page title="Purchase Requests" showNavButton="true" navButtonPress=".onNavBack">
        <headerContent>
            <Button icon="sap-icon://excel-attachment" text="Export" press=".onExport" />
            <Button icon="sap-icon://add" text="Create" type="Emphasized" press=".onCreatePress" />
        </headerContent>
        <content>
            <fb:FilterBar id="filterBar" search=".onSearch" showClearOnFB="true" clear=".onClear">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem groupName="G1" name="search" label="Search" visibleInFilterBar="true">
                        <fb:control>
                            <SearchField id="searchField" placeholder="Search by ID or Title..." />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem groupName="G1" name="status" label="Status" visibleInFilterBar="true">
                        <fb:control>
                            <ComboBox id="statusFilter">
                                <core:Item key="All" text="All Statuses" />
                                <core:Item key="Draft" text="Draft" />
                                <core:Item key="Pending Manager Approval" text="Pending Manager Approval" />
                                <core:Item key="Pending Finance Approval" text="Pending Finance Approval" />
                                <core:Item key="Pending Head Approval" text="Pending Procurement Head Approval" />
                                <core:Item key="Pending Procurement" text="Pending Procurement" />
                                <core:Item key="Vendor Selected" text="Vendor Selected" />
                                <core:Item key="PO Created" text="PO Created" />
                                <core:Item key="Partially Received" text="Partially Received" />
                                <core:Item key="Goods Received" text="Goods Received" />
                                <core:Item key="Completed" text="Completed" />
                                <core:Item key="Rejected" text="Rejected" />
                                <core:Item key="Changes Requested" text="Changes Requested" />
                                <core:Item key="Cancelled" text="Cancelled" />
                            </ComboBox>
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>

            <Table id="prTable" items="{path: '/PurchaseRequests', parameters: {$orderby: 'date desc'}}" mode="SingleSelectMaster" selectionChange=".onPRSelect">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Items" />
                        <ToolbarSpacer />
                        <Button icon="sap-icon://sort" tooltip="Sort" />
                        <Button icon="sap-icon://action-settings" tooltip="Settings" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column><Text text="Request ID" /></Column>
                    <Column><Text text="Details" /></Column>
                    <Column><Text text="Amount" /></Column>
                    <Column><Text text="Status" /></Column>
                    <Column><Text text="Requestor" /></Column>
                    <Column><Text text="Date" /></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation">
                        <cells>
                            <ObjectIdentifier title="{ID}" />
                            <VBox>
                                <Text text="{title}" />
                                <Text text="{department/name} • {= ${vendor/name} ? ${vendor/name} : 'No vendor selected'}"/>
                            </VBox>
                            <ObjectNumber number="{amount}" unit="{currency}" />
                            <ObjectStatus text="{status}"
                                state="{path: 'status', formatter: '.formatter.prStatusState'}" />
                            <Text text="{requestor/name}" />
                            <Text text="{date}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
