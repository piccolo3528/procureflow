<mvc:View controllerName="procureflow.controller.Approvals"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout">

    <Page title="Approval Center">
        <content>
            <layout:Splitter height="100%">
                <layout:contentAreas>
                    <VBox width="auto">
                        <layoutData><layout:SplitterLayoutData size="35%" resizable="true"/></layoutData>
                        <SearchField width="100%" placeholder="Search tasks..." class="sapUiTinyMargin" liveChange=".onSearch" id="searchField"/>
                        <List id="approvalList" items="{path: '/PurchaseRequests', parameters: {$orderby: 'date asc'}}" mode="SingleSelectMaster" selectionChange=".onListSelect" noDataText="Nothing pending your action right now.">
                            <StandardListItem
                                title="{title}"
                                description="{ID} - {requestor/name} - {status}"
                                info="{amount} {currency}"
                                type="Active" />
                        </List>
                    </VBox>
                    <VBox id="detailBox" visible="false" class="sapUiSmallMargin">
                        <layoutData><layout:SplitterLayoutData size="auto"/></layoutData>
                        <ObjectHeader title="{title}"
                            number="{amount}"
                            numberUnit="{currency}"
                            intro="{ID}">
                            <attributes>
                                <ObjectAttribute title="Requestor" text="{requestor/name}"/>
                                <ObjectAttribute title="Department" text="{department/name}"/>
                                <ObjectAttribute title="Date" text="{date}"/>
                                <ObjectAttribute title="Approval Route" text="{path: 'approvalRoute', formatter: '.formatter.approvalRoute'}"/>
                            </attributes>
                        </ObjectHeader>

                        <Panel headerText="Justification" class="sapUiSmallMarginBottom">
                            <Text text="{justification}" />
                        </Panel>

                        <Panel headerText="Budget Impact" class="sapUiSmallMarginBottom" visible="{= !!${department} }">
                            <Text text="{= 'Department budget: ' + ${department/budgetAvailable} + ' available, ' + ${department/budgetUsed} + ' already used.' }" />
                            <ProgressIndicator
                                percentValue="{= ${department/budgetAvailable} ? Math.round((${department/budgetUsed} / ${department/budgetAvailable}) * 100) : 0 }"
                                displayValue="{= ${department/budgetAvailable} ? Math.round((${department/budgetUsed} / ${department/budgetAvailable}) * 100) + '%' : '0%' }"
                                state="Information" class="sapUiTinyMarginTopBottom" />
                        </Panel>

                        <OverflowToolbar class="sapUiMediumMarginTop">
                            <ToolbarSpacer/>
                            <Button text="Request Changes" press=".onRequestChangesPress"/>
                            <Button text="Reject" type="Reject" press=".onRejectPress"/>
                            <Button text="Approve Request" type="Accept" press=".onApprovePress"/>
                        </OverflowToolbar>
                    </VBox>
                </layout:contentAreas>
            </layout:Splitter>
        </content>
    </Page>
</mvc:View>
