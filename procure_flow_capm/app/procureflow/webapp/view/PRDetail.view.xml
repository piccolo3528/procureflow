<mvc:View controllerName="procureflow.controller.PRDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core">

    <uxap:ObjectPageLayout id="ObjectPageLayout" showTitleInHeaderContent="true" showHeaderContent="true" upperCaseAnchorBar="false">
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <Title text="{title}" wrapping="true" class="sapUiSmallMarginEnd"/>
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <Title text="{title}" wrapping="true" class="sapUiSmallMarginEnd"/>
                </uxap:snappedHeading>
                <uxap:breadcrumbs>
                    <Breadcrumbs>
                        <Link text="Dashboard" press=".onNavToDashboard" />
                        <Link text="Purchase Requests" press=".onNavBack" />
                        <Link text="{ID}" enabled="false" />
                    </Breadcrumbs>
                </uxap:breadcrumbs>
                <uxap:actions>
                    <Button text="Submit" type="Emphasized" visible="{pageState>/canSubmit}" press=".onSubmitPress"/>
                    <Button text="Delete" type="Transparent" visible="{pageState>/canDelete}" press=".onDeletePress"/>
                    <Button text="Approve" type="Accept" visible="{pageState>/canApprove}" press=".onApprovePress"/>
                    <Button text="Reject" type="Reject" visible="{pageState>/canReject}" press=".onRejectPress"/>
                    <Button text="Request Changes" type="Transparent" visible="{pageState>/canRequestChanges}" press=".onRequestChangesPress"/>
                    <Button text="Select Vendor" type="Emphasized" visible="{pageState>/canSelectVendor}" press=".onSelectVendorPress"/>
                    <Button text="Generate PO" type="Emphasized" visible="{pageState>/canGeneratePO}" press=".onGeneratePOPress"/>
                    <Button text="Cancel Request" type="Transparent" visible="{pageState>/canCancel}" press=".onCancelPress"/>
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        <uxap:headerContent>
            <FlexBox wrap="Wrap" fitContainer="true" alignItems="Stretch">
                <layout:VerticalLayout class="sapUiSmallMarginRight sapUiSmallMarginBottom">
                    <Label text="Status" />
                    <ObjectStatus text="{status}"
                        state="{= ${status} === 'Goods Received' || ${status} === 'PO Created' ? 'Success' : (${status} === 'Rejected' || ${status} === 'Cancelled' ? 'Error' : (${status} === 'Draft' ? 'None' : 'Warning')) }" />
                </layout:VerticalLayout>
                <layout:VerticalLayout class="sapUiSmallMarginRight sapUiSmallMarginBottom">
                    <Label text="Requestor" />
                    <Text text="{requestor/name}" />
                </layout:VerticalLayout>
                <layout:VerticalLayout class="sapUiSmallMarginRight sapUiSmallMarginBottom">
                    <Label text="Department" />
                    <Text text="{department/name}" />
                </layout:VerticalLayout>
                <layout:VerticalLayout class="sapUiSmallMarginRight sapUiSmallMarginBottom">
                    <Label text="Total Amount" />
                    <ObjectNumber number="{amount}" unit="{currency}" />
                </layout:VerticalLayout>
            </FlexBox>
        </uxap:headerContent>

        <uxap:sections>
            <uxap:ObjectPageSection title="General Information" id="sectionGeneral">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <layout:Grid defaultSpan="XL4 L4 M6 S12">
                                <VBox>
                                    <Label text="Request ID" class="sapUiTinyMarginBottom" design="Bold"/>
                                    <Text text="{ID}" />
                                </VBox>
                                <VBox>
                                    <Label text="Priority" class="sapUiTinyMarginBottom" design="Bold"/>
                                    <Select selectedKey="{priority}" enabled="{pageState>/canEditItems}" width="10rem">
                                        <core:Item key="Low" text="Low"/>
                                        <core:Item key="Normal" text="Normal"/>
                                        <core:Item key="High" text="High"/>
                                    </Select>
                                </VBox>
                                <VBox>
                                    <Label text="Required Delivery Date" class="sapUiTinyMarginBottom" design="Bold"/>
                                    <DatePicker value="{requiredDate}" valueFormat="yyyy-MM-dd" displayFormat="yyyy-MM-dd" editable="{pageState>/canEditItems}" width="10rem"/>
                                </VBox>
                                <VBox>
                                    <Label text="Selected Vendor" class="sapUiTinyMarginBottom" design="Bold"/>
                                    <Text text="{= ${vendor/name} ? ${vendor/name} : 'Not yet selected' }" />
                                </VBox>
                                <VBox class="sapUiSmallMarginTop">
                                    <Label text="Business Justification" class="sapUiTinyMarginBottom" design="Bold"/>
                                    <TextArea value="{justification}" rows="2" width="100%" editable="{pageState>/canEditItems}"/>
                                </VBox>
                            </layout:Grid>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <uxap:ObjectPageSection title="Requested Items" id="sectionItems">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <Table id="itemsTable" items="{items}">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="Items"/>
                                        <ToolbarSpacer/>
                                        <Button icon="sap-icon://add" text="Add Item" type="Transparent" visible="{pageState>/canEditItems}" press=".onAddItemRowPress"/>
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column><Text text="Description" /></Column>
                                    <Column><Text text="Category" /></Column>
                                    <Column><Text text="Qty" /></Column>
                                    <Column><Text text="Unit Price" /></Column>
                                    <Column hAlign="End"><Text text="Total" /></Column>
                                    <Column visible="{pageState>/canEditItems}"><Text text="" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Input value="{description}" editable="{pageState>/canEditItems}"/>
                                            <Input value="{category}" editable="{pageState>/canEditItems}"/>
                                            <Input value="{qty}" type="Number" editable="{pageState>/canEditItems}"/>
                                            <Input value="{price}" type="Number" editable="{pageState>/canEditItems}"/>
                                            <ObjectNumber number="{total}"/>
                                            <Button icon="sap-icon://delete" type="Reject" visible="{pageState>/canEditItems}" press=".onDeleteItemRowPress"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <uxap:ObjectPageSection title="Approval History" id="sectionApproval">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <Table id="approvalHistoryTable" items="{path: 'approvalHistory', parameters: {$orderby: 'createdAt asc'}}" noDataText="No approval activity yet.">
                                <columns>
                                    <Column><Text text="When" /></Column>
                                    <Column><Text text="By" /></Column>
                                    <Column><Text text="Action" /></Column>
                                    <Column><Text text="Status Change" /></Column>
                                    <Column><Text text="Comment" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{path: 'createdAt', formatter: '.formatter.relativeDateTime'}" />
                                            <Text text="{actor/name} ({role})" />
                                            <ObjectStatus text="{action}" />
                                            <Text text="{fromStatus} → {toStatus}" />
                                            <Text text="{comment}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <uxap:ObjectPageSection title="Comments" id="sectionComments">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <VBox>
                                <List id="commentsList" items="{path: 'comments', parameters: {$orderby: 'createdAt asc'}}" noDataText="No comments yet.">
                                    <StandardListItem
                                        title="{author/name}"
                                        description="{text}"
                                        info="{path: 'createdAt', formatter: '.formatter.relativeDateTime'}" />
                                </List>
                                <HBox class="sapUiSmallMarginTop" alignItems="End">
                                    <TextArea id="newCommentText" rows="2" width="100%" placeholder="Add a comment..." class="sapUiTinyMarginEnd"/>
                                    <Button text="Post" type="Emphasized" press=".onPostComment"/>
                                </HBox>
                            </VBox>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <uxap:ObjectPageSection title="Related Purchase Order" id="sectionPO">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <Table id="relatedPOTable" items="{purchaseOrders}" noDataText="No Purchase Order generated yet.">
                                <columns>
                                    <Column><Text text="PO Number" /></Column>
                                    <Column><Text text="Vendor" /></Column>
                                    <Column><Text text="Amount" /></Column>
                                    <Column><Text text="Status" /></Column>
                                    <Column><Text text="Date" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectIdentifier title="{ID}" />
                                            <Text text="{vendor/name}" />
                                            <ObjectNumber number="{amount}" unit="{currency}" />
                                            <ObjectStatus text="{status}" state="{= ${status} === 'Closed' ? 'Success' : (${status} === 'Cancelled' ? 'Error' : 'Information') }"/>
                                            <Text text="{date}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>
